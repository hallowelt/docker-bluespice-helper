#!/bin/bash
mkdir -p ${BLUESPICE_DATABASE_BACKUP_DIRECTORY}
if [[ ! ${TAR_BACKUP} ]]; then
	mkdir -p ${BLUESPICE_BACKUP_DIRECTORY}

	if [[ -n "${BLUESPICE_BACKUP_PASS}" ]]; then
		echo -n "${BLUESPICE_BACKUP_PASS}" > /tmp/.BLUESPICE_BACKUP_PASS
		BACKUP_PASS_FILE="/tmp/.BLUESPICE_BACKUP_PASS"
	else
		BACKUP_PASS_FILE="/data/.secrets/BLUESPICE_BACKUP_PASS"
	fi

	if ! restic -r ${BLUESPICE_BACKUP_DIRECTORY} cat config --password-file "${BACKUP_PASS_FILE}" > /dev/null 2>&1; then
		restic -r ${BLUESPICE_BACKUP_DIRECTORY} init --password-file "${BACKUP_PASS_FILE}"
	fi
else
	mkdir -p ${BLUESPICE_TAR_BACKUP_DIRECTORY}
fi