#!/bin/bash
mkdir -p ${BLUESPICE_DATABASE_BACKUP_DIRECTORY}
if [[ ! ${TAR_BACKUP} ]]; then
	mkdir -p ${BLUESPICE_BACKUP_DIRECTORY}
	if [[ ! ${BLUESPICE_BACKUP_PASS} ]]; then
		RESTIC_PASS=$(openssl rand -base64 16 | tr -d '/+=' | cut -c1-16)
		echo "$RESTIC_PASS" > /tmp/.BLUESPICE_BACKUP_PASS
		echo "BLUESPICE_BACKUP_PASS=$RESTIC_PASS" >> /data/wiki/.wikienv
	if [[ ${BLUESPICE_BACKUP_PASS} ]]; then
			echo ${BLUESPICE_BACKUP_PASS} > /tmp/.BLUESPICE_PACKUP_PASS
	
	if [[ -d /data/.secrets ]] && [[ ! $(restic -r ${BLUESPICE_BACKUP_DIRECTORY} cat config --password-file /tmp/.BLUESPICE_BACKUP_PASS )  ]]; then
		restic -r ${BLUESPICE_BACKUP_DIRECTORY} init --password-file /data/.secrets/BLUESPICE_BACKUP_PASS > /proc/1/fd/1 2>&1 ;
	fi
	if [[ ${WIKI_BACKUP_PASS} ]] && [[ ! $(restic -r ${BLUESPICE_BACKUP_DIRECTORY} cat config --password-file /tmo/.BLUESPICE_BACKUP_PASS )  ]]; then
		restic -r ${BLUESPICE_BACKUP_DIRECTORY} init --password-file /data/.BLUESPICE_BACKUP_PASS > /proc/1/fd/1 2>&1 ;
	fi
else
	mkdir -p ${BLUESPICE_TAR_BACKUP_DIRECTORY}
fi