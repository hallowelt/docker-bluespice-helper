#!/bin/bash
if [[ ${1} != "--no-restic" ]]; then

	if [[ ! $(restic -r ${BLUESPICE_BACKUP_DIRECTORY} cat config --password-file /data/.secrets/WIKI_BACKUP_PASS )  ]]; then
		restic -r ${BLUESPICE_BACKUP_DIRECTORY} init --password-file /data/.secrets/WIKI_BACKUP_PASS > /proc/1/fd/1 2>&1 ;
	fi
else
	mkdir -p ${BLUESPICE_TAR_BACKUP_DIRECTORY}
fi
