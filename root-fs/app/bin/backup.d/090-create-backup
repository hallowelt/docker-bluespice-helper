#!/bin/bash
if [[ TAR_BACKUP ]]; then
	TIMESTAMP=`date +%Y-%m-%d_%H-%M-%S`
	TAR_EXCLUDE=/app/bin/backup.d/conf/tar_exclude
	mkdir -p ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}	
	for f in /data/wiki/*; do
		if [[ -d "$f" ]] ; then
			echo ""
			echo "🔧 Backing up $f"
			s=${f##/*/}
			tar czf  ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}/$s.tar.gz --exclude-from="${TAR_EXCLUDE}" -C /data/wiki/ $s

		fi
	done

	tar czf ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}.tar.gz -C ${BLUESPICE_TAR_BACKUP_DIRECTORY} ${WIKI_HOST}_${TIMESTAMP}
	rm -fr ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}
	echo "Saved Backup from ${TIMESTAMP} at ${BLUESPICE_TAR_BACKUP_DIRECTORY}"
	exit 0
fi	
if [[  $(restic -r ${BLUESPICE_BACKUP_DIRECTORY} cat config --password-file /data/.secrets/WIKI_BACKUP_PASS  > /dev/null 2>&1 ) ]]; then
	restic -r ${BLUESPICE_BACKUP_DIRECTORY} backup /data/wiki/ --exclude-file=/app/bin/backup.d/conf/restic_excludes.txt --password-file /data/.secrets/WIKI_BACKUP_PASS  > /proc/1/fd/1 2>&1 ;
else