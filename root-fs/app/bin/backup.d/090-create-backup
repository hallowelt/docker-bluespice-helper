#!/bin/bash
if [[  $(restic -r /data/backup/ cat config --password-file /data/.secrets/WIKI_BACKUP_PASS  > /dev/null 2>&1 ) ]]; then
	restic -r /data/backup/ backup /data/wiki/ --exclude-file=/app/bin/backup.d/conf/restic_excludes.txt --password-file /data/.secrets/WIKI_BACKUP_PASS  > /proc/1/fd/1 2>&1 ;
else
	TIMESTAMP=`date +%Y-%m-%d_%H-%M-%S`
	mkdir -p ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}	
	for f in /data/wiki/*; do
		if [ -d "$f" ]; then
			echo ""
			echo "🔧 Backing up $f"
			s=${f##/*/}
			tar czf  ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}/$s.tar.gz  -C /data/wiki/ $s

		fi
	done

	tar czf ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}.tar.gz -C ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}
	rm -fr ${BLUESPICE_TAR_BACKUP_DIRECTORY}/${WIKI_HOST}_${TIMESTAMP}
fi	
