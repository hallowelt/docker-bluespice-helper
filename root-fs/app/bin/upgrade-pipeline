#!/bin/bash
# Upgrade of a BlueSpice 5.x installation to 6.x. Runs the scripts in /app/bin/upgrade6x once;
# `-f` forces a rerun.
export LOGFILE=/data/wiki/bluespice/logs/backend_upgrade_6.log

while getopts ":f" option; do
	case $option in
		f) # rerun upgrade
			if [ -f ${LOGFILE} ]; then
				cat ${LOGFILE} >> ${LOGFILE}.bak
				rm -f ${LOGFILE}
			fi
			;;
	esac
done

if grep -qs "Upgrade to 6.x finished" ${LOGFILE}; then
	echo "Upgrade already done, see ${LOGFILE}. Use the profile 'upgrade-force' to rerun it."
	exit 0
fi

mkdir -p $(dirname ${LOGFILE})
echo "$(date '+%Y-%m-%d %H:%M:%S') Upgrade to 6.x started" >> ${LOGFILE}
for f in /app/bin/upgrade6x/*; do
	echo "Running $f"
	$f || { echo "$f failed" | tee -a ${LOGFILE}; exit 1; }
done
echo "$(date '+%Y-%m-%d %H:%M:%S') Upgrade to 6.x finished" | tee -a ${LOGFILE}
