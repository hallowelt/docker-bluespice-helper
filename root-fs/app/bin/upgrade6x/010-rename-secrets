#!/bin/bash

# Secrets renamed since 5.x: keep the value of the existing installation instead of generating a new one
echo "#############################################"
echo "🔐 Renaming secrets"

secrets_dir="/data/.secrets"
declare -A renamed_secrets=(
  ["INTERNAL_CHAT_WIKI_ACCESS_TOKEN"]="INTERNAL_CHAT_WIKI_API_KEY"
)

for old_name in ${!renamed_secrets[@]}; do
  new_name=${renamed_secrets[$old_name]}
  if [ -f "$secrets_dir/$old_name" ] && [ ! -f "$secrets_dir/$new_name" ]; then
    mv "$secrets_dir/$old_name" "$secrets_dir/$new_name"
    echo "$(date '+%Y-%m-%d %H:%M:%S') Renamed secret $old_name to $new_name" | tee -a ${LOGFILE}
  else
    echo "Nothing to rename for $old_name"
  fi
done
