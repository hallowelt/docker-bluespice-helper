#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

export BLUESPICE_BACKUP_DIRECTORY=${BLUESPICE_BACKUP_DIRECTORY:-'/data/backup/restic'}
export BLUESPICE_TAR_BACKUP_DIRECTORY=${BLUESPICE_TAR_BACKUP_DIRECTORY:-'/data/backup/tar-backup'}

if [[ -z "${RESTORE_BACKUP_FILE:-}" ]]; then
	echo "ERROR: RESTORE_BACKUP_FILE environment variable must be set"
	exit 1
fi

if [[ ! -f "${RESTORE_BACKUP_FILE}" ]]; then
	echo "ERROR: Backup file not found: ${RESTORE_BACKUP_FILE}"
	exit 1
fi

echo ""
echo "#############################################"
echo "🔄 Starting restore from ${RESTORE_BACKUP_FILE}"
echo "#############################################"

for f in /app/bin/restore.d/*; do
	if [ -f "$f" ]; then
		echo ""
		echo "🔧 Running $f"
		$f $*
	fi
done

echo ""
echo "#############################################"
echo "✅ Restore completed"
echo "#############################################"
