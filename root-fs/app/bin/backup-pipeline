#!/bin/bash
export BLUESPICE_DATABASE_BACKUP_DIRECTORY=${BLUESPICE_DATABASE_BACKUP_DIRECTORY:-'/data/wiki/db_backup'}
export BLUESPICE_BACKUP_DIRECTORY=${BLUESPICE_BACKUP_DIRECTORY:-'/data/backup/restic'}
export BLUESPICE_TAR_BACKUP_DIRECTORY=${BLUESPICE_TAR_BACKUP_DIRECTORY:-'/data/backup/tar-backup'}
for f in /app/bin/backup.d/*; do
	if [ -f "$f" ]; then
		echo ""
		echo "🔧 Running $f"
		$f $*
	fi
done